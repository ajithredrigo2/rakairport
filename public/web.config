<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS config for the RAK Airport React site.
  Requires the "URL Rewrite" module installed on the server:
  https://www.iis.net/downloads/microsoft/url-rewrite
-->
<configuration>
  <system.webServer>

    <!-- Serve index.html by default -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Reverse-proxy the AI API to the Node server (server/rakia-server.mjs)
         running on localhost:3001. Requires IIS "URL Rewrite" + "Application
         Request Routing (ARR)" with proxy enabled at the server level.
         Frontend calls same-origin "/chat"; IIS forwards it to Node. -->
    <rewrite>
      <rules>
        <!-- Canonical public address. This must be before API and SPA rules.
             IIS still needs a valid certificate for BOTH rakairport.com and
             www.rakairport.com, because TLS is validated before this redirect. -->
        <rule name="Force HTTPS and www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^off$" />
            <add input="{HTTP_HOST}" pattern="^www\.rakairport\.com(?::\d+)?$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.rakairport.com/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- Retired assistant assets must never be served by the public site. -->
        <rule name="Block legacy assistant directory" stopProcessing="true">
          <match url="^assistant(?:/.*)?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Live flight data (FIDS API). Forwards same-origin "/getFlights?type=ARR|DEP"
             to the FIDS API running on port 3000. The query string is preserved. -->
        <rule name="FIDS Flights proxy" stopProcessing="true">
          <match url="^getFlights$" ignoreCase="true" />
          <action type="Rewrite" url="http://127.0.0.1:3000/getFlights" appendQueryString="true" />
        </rule>

        <!-- Chatbot AI (optional) -> Node server on 3001. Remove if unused. -->
        <rule name="AI API proxy" stopProcessing="true">
          <match url="^chat$" ignoreCase="true" />
          <action type="Rewrite" url="http://127.0.0.1:3001/chat" appendQueryString="true" />
        </rule>

        <!-- Never expose deployment files, source code, or retired assistant files. -->
        <rule name="Block deployment artifacts" stopProcessing="true">
          <match url="^(?:\.env(?:\..*)?|\.git(?:/.*)?|\.svn(?:/.*)?|node_modules(?:/.*)?|server(?:/.*)?)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- SPA fallback: any URL that is not a real file/folder -> index.html
             so React Router routes (/flights, /parking, ...) work on refresh. -->
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
      <!-- The Flights API response passes through ARR. Remove backend server
           identifiers from that proxied response as well as IIS responses. -->
      <outboundRules>
        <rule name="Remove proxied X-Powered-By header">
          <match serverVariable="RESPONSE_X-Powered-By" pattern=".+" />
          <action type="Rewrite" value="" />
        </rule>
      </outboundRules>
    </rewrite>

    <!-- MIME types IIS may not serve by default (remove first to avoid duplicates) -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".jpeg" />
      <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <!-- Reduce software/version disclosure in public responses. -->
    <security>
      <requestFiltering removeServerHeader="true" allowDoubleEscaping="false" />
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />
        <!-- HTTPS is established on both public host names. -->
        <remove name="Strict-Transport-Security" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="Cross-Origin-Opener-Policy" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <!-- Enforced policy for the known Google Fonts, Google Maps, airport
             image, flight API, chat, and optional analytics sources. -->
        <remove name="Content-Security-Policy-Report-Only" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.rakairport.com https://www.google-analytics.com https://region1.google-analytics.com https://maps.googleapis.com https://mapsresources-pa.googleapis.com https://maps.gstatic.com; frame-src https://maps.google.com https://www.google.com; upgrade-insecure-requests" />
      </customHeaders>
    </httpProtocol>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto" />

  </system.webServer>
</configuration>
