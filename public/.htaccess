# RAK Airport site — Apache / LiteSpeed (MilesWeb) config

# Serve real files/folders directly (assets, /api/chat.php, images…),
# and route everything else to index.html so React Router works on refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# Never serve the API key file or the raw knowledge JSON is fine to read but
# block direct access to config.php just in case.
<Files "config.php">
  Require all denied
</Files>
