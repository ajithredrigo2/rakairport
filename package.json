    "gen:kb": "node scripts/gen-knowledge.mjs",
    "build": "node scripts/generate-seo.mjs && node scripts/gen-knowledge.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
