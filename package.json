    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.5"
  }
}
